| Logging/error paths        |           1–2 |
| **Total**                  | **~30 tests** |




private static string MapCustomer(CustomerXmlModel customer)
{
    return string.Join("|",
        customer.CustomerId?.Trim(),
        customer.FirstName?.Trim(),
        customer.LastName?.Trim(),
        FormatDate(customer.DateOfBirth),
        customer.Email?.Trim(),
        customer.Phone?.Trim(),
        customer.Address?.AddressLine1?.Trim(),
        customer.Address?.AddressLine2?.Trim(),
        customer.Address?.City?.Trim(),
        customer.Address?.PostCode?.Trim(),
        customer.Address?.Country?.Trim()
    );
}

private static string MapCustomer(CustomerXmlModel customer)
{
    return string.Join("|",
        $"CustomerId={customer.CustomerId?.Trim()}",
        $"FirstName={customer.FirstName?.Trim()}",
        $"LastName={customer.LastName?.Trim()}",
        $"DateOfBirth={FormatDate(customer.DateOfBirth)}",
        $"Email={customer.Email?.Trim()}",
        $"Phone={customer.Phone?.Trim()}",
        $"AddressLine1={customer.Address?.AddressLine1?.Trim()}",
        $"AddressLine2={customer.Address?.AddressLine2?.Trim()}",
        $"City={customer.Address?.City?.Trim()}",
        $"PostCode={customer.Address?.PostCode?.Trim()}",
        $"Country={customer.Address?.Country?.Trim()}"
    );
}
